# ════════════════════════════════════════════════════════════
# Environment Variables — Platform E-Commerce Mandiri Fashion
# Copy this file to .env and fill in the values
# ════════════════════════════════════════════════════════════

# ── Django ─────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=True

# ── Database ───────────────────────────────────────────────
DB_ENGINE=mysql
DB_NAME=ecommerce_fashion
DB_USER=root
DB_PASSWORD=your-password-here
DB_HOST=127.0.0.1
DB_PORT=3306

# Password utk container MySQL (docker-compose) — WAJIB diisi & jangan dipublikasikan
MYSQL_ROOT_PASSWORD=your-password-here
MYSQL_DATABASE=ecommerce_fashion

# ── Midtrans (sandbox) ────────────────────────────────────
# WAJIB diisi dengan key sandbox asli dr dashboard Midtrans (bukan placeholder).
# Production settings TIDAK AKAN STARTUP kalau key kosong (security guard).
MIDTRANS_SERVER_KEY=isi-server-key-sandbox-asli-di-sini
MIDTRANS_CLIENT_KEY=isi-client-key-sandbox-asli-di-sini
MIDTRANS_IS_PRODUCTION=False
MIDTRANS_WEBHOOK_URL=/api/v1/payments/webhook/

# ── Media / File Upload ───────────────────────────────────
MEDIA_ROOT=media/
MEDIA_URL=/media/
MAX_UPLOAD_SIZE_MB=5

# ── Email (Notifikasi) ────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=
EMAIL_PASSWORD=

# ── CORS (Development) ────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
